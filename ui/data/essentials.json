  "cards": [
    { "id": "ev1", "cat": "everyday", "term": "What's up?", "ko": "잘 지내? / 무슨 일이야?", "example": "Hey, what's up? Haven't seen you in a while.", "example_ko": "야, 잘 지내? 오랜만이네.", "register": "casual" },
    { "id": "ev2", "cat": "everyday", "term": "I'm good.", "ko": "난 괜찮아 (거절·안부 둘 다)", "example": "Want a refill? — I'm good, thanks.", "example_ko": "더 채워줄까? — 괜찮아, 고마워.", "register": "casual" },
    { "id": "ev3", "cat": "everyday", "term": "No worries.", "ko": "괜찮아 / 신경 쓰지 마", "example": "Sorry I'm late! — No worries, we just started.", "example_ko": "늦어서 미안! — 괜찮아, 방금 시작했어.", "register": "neutral" },
    { "id": "ev4", "cat": "everyday", "term": "My bad.", "ko": "내 실수야 / 미안", "example": "You took my coffee. — Oh, my bad!", "example_ko": "내 커피 가져갔어. — 아, 내 실수!", "register": "casual" },
    { "id": "ev5", "cat": "everyday", "term": "It is what it is.", "ko": "어쩔 수 없지 / 그게 현실이지", "example": "The flight got canceled. It is what it is.", "example_ko": "비행기 취소됐어. 뭐 어쩔 수 없지.", "register": "neutral" },
    { "id": "ev6", "cat": "everyday", "term": "Sounds good.", "ko": "좋아 / 그렇게 하자", "example": "Let's meet at six. — Sounds good.", "example_ko": "6시에 보자. — 좋아.", "register": "neutral" },
    { "id": "ev7", "cat": "everyday", "term": "Same here.", "ko": "나도 마찬가지야", "example": "I'm exhausted. — Same here.", "example_ko": "나 완전 지쳤어. — 나도.", "register": "neutral" },
    { "id": "ev8", "cat": "everyday", "term": "Never mind.", "ko": "아냐, 됐어 / 신경 쓰지 마", "example": "What did you say? — Never mind, it's not important.", "example_ko": "뭐라고 했어? — 아냐, 중요한 거 아냐.", "register": "neutral" },
    { "id": "ev9", "cat": "everyday", "term": "I'll let you know.", "ko": "알려줄게 / 확인하고 말해줄게", "example": "Are you coming Friday? — I'll let you know.", "example_ko": "금요일에 와? — 확인하고 알려줄게.", "register": "neutral" },
    { "id": "ev10", "cat": "everyday", "term": "Take it easy.", "ko": "잘 지내 / 무리하지 마 (작별·위로)", "example": "I'm heading out. — Take it easy, man.", "example_ko": "나 갈게. — 잘 가, 친구.", "register": "casual" },

    { "id": "re1", "cat": "reactions", "term": "No way!", "ko": "말도 안 돼! / 진짜?", "example": "I got the job! — No way! Congrats!", "example_ko": "나 그 일자리 됐어! — 말도 안 돼! 축하해!", "register": "casual" },
    { "id": "re2", "cat": "reactions", "term": "For real?", "ko": "진짜로? / 정말?", "example": "She's moving to Korea. — For real?", "example_ko": "걔 한국으로 이사 가. — 진짜로?", "register": "casual" },
    { "id": "re3", "cat": "reactions", "term": "That's wild.", "ko": "와 대박이다 / 엄청나네", "example": "He ran a marathon with no training. — That's wild.", "example_ko": "걔 연습도 없이 마라톤 뛰었대. — 와 대박.", "register": "casual" },
    { "id": "re4", "cat": "reactions", "term": "You're kidding.", "ko": "농담이지? / 설마", "example": "We won the lottery pool. — You're kidding!", "example_ko": "우리 복권 당첨됐어. — 설마, 농담이지!", "register": "casual" },
    { "id": "re5", "cat": "reactions", "term": "That makes sense.", "ko": "그럴 만하네 / 이해돼", "example": "She left early to beat traffic. — That makes sense.", "example_ko": "걔 차 막힐까 봐 일찍 갔어. — 그럴 만하네.", "register": "neutral" },
    { "id": "re6", "cat": "reactions", "term": "Good for you.", "ko": "잘됐다 / 축하해 (진심·비꼼 둘 다)", "example": "I quit and started my own thing. — Good for you!", "example_ko": "나 그만두고 내 일 시작했어. — 잘됐다!", "register": "neutral" },
    { "id": "re7", "cat": "reactions", "term": "I feel you.", "ko": "무슨 말인지 알아 / 공감해", "example": "Mondays are brutal. — I feel you.", "example_ko": "월요일은 진짜 힘들어. — 무슨 말인지 알아.", "register": "casual" },
    { "id": "re8", "cat": "reactions", "term": "That's a relief.", "ko": "다행이다", "example": "The test came back negative. — That's a relief.", "example_ko": "검사 음성 나왔어. — 다행이다.", "register": "neutral" },
    { "id": "re9", "cat": "reactions", "term": "Tell me about it.", "ko": "내 말이 / 누가 아니래 (강한 공감)", "example": "Rent is insane these days. — Tell me about it.", "example_ko": "요즘 월세 미쳤어. — 내 말이.", "register": "casual" },
    { "id": "re10", "cat": "reactions", "term": "Fair enough.", "ko": "그래 일리 있네 / 인정", "example": "I'd rather not, I'm tired. — Fair enough.", "example_ko": "안 할래, 피곤해. — 그래 인정.", "register": "neutral" },

    { "id": "sm1", "cat": "smalltalk", "term": "How's it going?", "ko": "어떻게 지내? (가벼운 인사)", "example": "Hey! How's it going?", "example_ko": "안녕! 어떻게 지내?", "register": "neutral" },
    { "id": "sm2", "cat": "smalltalk", "term": "What have you been up to?", "ko": "요즘 뭐 하고 지냈어?", "example": "Long time! What have you been up to?", "example_ko": "오랜만이야! 요즘 뭐 하고 지냈어?", "register": "neutral" },
    { "id": "sm3", "cat": "smalltalk", "term": "Long time no see.", "ko": "오랜만이야", "example": "Long time no see — you look great!", "example_ko": "오랜만이야 — 좋아 보인다!", "register": "casual" },
    { "id": "sm4", "cat": "smalltalk", "term": "Let's catch up.", "ko": "조만간 회포 풀자 / 근황 나누자", "example": "We should grab coffee and catch up.", "example_ko": "커피 마시면서 근황 얘기하자.", "register": "neutral" },
    { "id": "sm5", "cat": "smalltalk", "term": "How was your weekend?", "ko": "주말 어땠어?", "example": "Morning! How was your weekend?", "example_ko": "좋은 아침! 주말 어땠어?", "register": "neutral" },
    { "id": "sm6", "cat": "smalltalk", "term": "Same old, same old.", "ko": "맨날 똑같지 뭐", "example": "How's work? — Same old, same old.", "example_ko": "일은 어때? — 맨날 똑같지 뭐.", "register": "casual" },
    { "id": "sm7", "cat": "smalltalk", "term": "I can't complain.", "ko": "그럭저럭 괜찮아 (불만 없어)", "example": "How are things? — Can't complain.", "example_ko": "요즘 어때? — 그럭저럭 괜찮아.", "register": "neutral" },
    { "id": "sm8", "cat": "smalltalk", "term": "We should hang out.", "ko": "같이 좀 놀자 / 보자", "example": "We should hang out sometime soon.", "example_ko": "조만간 한번 보자.", "register": "casual" },
    { "id": "sm9", "cat": "smalltalk", "term": "Keep in touch.", "ko": "연락하고 지내자", "example": "Great seeing you — keep in touch!", "example_ko": "만나서 반가웠어 — 연락하고 지내자!", "register": "neutral" },
    { "id": "sm10", "cat": "smalltalk", "term": "What's new?", "ko": "별일 없어? / 새로운 거 있어?", "example": "Hey stranger, what's new?", "example_ko": "야 오랜만, 별일 없어?", "register": "casual" },

    { "id": "op1", "cat": "opinions", "term": "I'm on board.", "ko": "나 찬성이야 / 동참할게", "example": "Let's redo the homepage. — I'm on board.", "example_ko": "홈페이지 새로 하자. — 나 찬성.", "register": "neutral" },
    { "id": "op2", "cat": "opinions", "term": "I see your point.", "ko": "무슨 말인지 알겠어 (부분 동의)", "example": "It's risky. — I see your point, but it's worth it.", "example_ko": "위험해. — 무슨 말인지 알아, 근데 해볼 만해.", "register": "neutral" },
    { "id": "op3", "cat": "opinions", "term": "I beg to differ.", "ko": "난 생각이 좀 달라 (정중한 반대)", "example": "It's the best option. — I beg to differ.", "example_ko": "그게 최선이야. — 난 생각이 좀 달라.", "register": "business" },
    { "id": "op4", "cat": "opinions", "term": "That's a good point.", "ko": "좋은 지적이야", "example": "What about the cost? — That's a good point.", "example_ko": "비용은? — 좋은 지적이야.", "register": "neutral" },
    { "id": "op5", "cat": "opinions", "term": "I'd say...", "ko": "내 생각엔 ~인 것 같아 (부드러운 의견)", "example": "I'd say we wait a week.", "example_ko": "내 생각엔 일주일 기다리는 게 좋을 듯.", "register": "neutral" },
    { "id": "op6", "cat": "opinions", "term": "It depends.", "ko": "상황에 따라 달라", "example": "Is it worth it? — It depends.", "example_ko": "그럴 가치 있어? — 상황 따라 달라.", "register": "neutral" },
    { "id": "op7", "cat": "opinions", "term": "Either way works.", "ko": "어느 쪽이든 괜찮아", "example": "Lunch or dinner? — Either way works for me.", "example_ko": "점심 아니면 저녁? — 난 어느 쪽이든 괜찮아.", "register": "neutral" },
    { "id": "op8", "cat": "opinions", "term": "I'm not so sure.", "ko": "글쎄, 잘 모르겠어 (완곡한 반대)", "example": "This'll definitely work. — I'm not so sure.", "example_ko": "이거 분명 될 거야. — 글쎄, 잘 모르겠어.", "register": "neutral" },
    { "id": "op9", "cat": "opinions", "term": "Let's play it by ear.", "ko": "그때 봐서 정하자 / 상황 봐가며 하자", "example": "What's the plan? — Let's play it by ear.", "example_ko": "계획이 뭐야? — 그때 봐서 정하자.", "register": "casual" },
    { "id": "op10", "cat": "opinions", "term": "That works for me.", "ko": "난 그게 괜찮아 / 좋아", "example": "How about Thursday? — That works for me.", "example_ko": "목요일 어때? — 난 좋아.", "register": "neutral" },

    { "id": "so1", "cat": "softeners", "term": "Would you mind...?", "ko": "혹시 ~해 주실 수 있을까요? (정중)", "example": "Would you mind closing the window?", "example_ko": "혹시 창문 좀 닫아 주실 수 있을까요?", "register": "neutral" },
    { "id": "so2", "cat": "softeners", "term": "I was wondering if...", "ko": "혹시 ~인지 궁금해서요 (정중한 부탁)", "example": "I was wondering if you had a minute.", "example_ko": "혹시 잠깐 시간 되시는지 해서요.", "register": "business" },
    { "id": "so3", "cat": "softeners", "term": "No rush.", "ko": "급하지 않아요 / 천천히 하세요", "example": "I'll send it later — no rush.", "example_ko": "나중에 보낼게요 — 급하지 않아요.", "register": "neutral" },
    { "id": "so4", "cat": "softeners", "term": "If that works for you.", "ko": "괜찮으시다면요", "example": "Let's say 3 p.m., if that works for you.", "example_ko": "3시로 하죠, 괜찮으시다면요.", "register": "business" },
    { "id": "so5", "cat": "softeners", "term": "Just to be safe.", "ko": "혹시 모르니까 / 만약을 위해", "example": "Let's back it up, just to be safe.", "example_ko": "혹시 모르니까 백업해 두자.", "register": "neutral" },
    { "id": "so6", "cat": "softeners", "term": "Correct me if I'm wrong.", "ko": "제가 틀렸으면 말씀해 주세요", "example": "Correct me if I'm wrong, but it's due Monday.", "example_ko": "제가 틀렸으면 말씀해 주세요, 월요일 마감 맞죠?", "register": "business" },
    { "id": "so7", "cat": "softeners", "term": "When you get a chance.", "ko": "시간 될 때 (재촉 안 함)", "example": "Review it when you get a chance.", "example_ko": "시간 될 때 검토해 주세요.", "register": "business" },
    { "id": "so8", "cat": "softeners", "term": "I don't mean to bother you, but...", "ko": "방해해서 죄송한데요", "example": "I don't mean to bother you, but do you have a sec?", "example_ko": "방해해서 죄송한데, 잠깐 시간 되세요?", "register": "neutral" },
    { "id": "so9", "cat": "softeners", "term": "Whenever works for you.", "ko": "편하신 때 아무 때나요", "example": "Pick a time — whenever works for you.", "example_ko": "시간 정하세요 — 편하신 때 아무 때나요.", "register": "neutral" },
    { "id": "so10", "cat": "softeners", "term": "Feel free to...", "ko": "편하게 ~하세요", "example": "Feel free to reach out anytime.", "example_ko": "언제든 편하게 연락 주세요.", "register": "business" },

    { "id": "ph1", "cat": "phrasal", "term": "figure out", "ko": "알아내다 / 해결하다", "example": "Let me figure out the schedule and get back to you.", "example_ko": "일정 좀 알아보고 다시 연락할게요.", "register": "neutral" },
    { "id": "ph2", "cat": "phrasal", "term": "bring up", "ko": "(화제를) 꺼내다 / 언급하다", "example": "Can we bring this up in the meeting?", "example_ko": "이거 회의에서 꺼내도 될까요?", "register": "neutral" },
    { "id": "ph3", "cat": "phrasal", "term": "run by", "ko": "~에게 (의견을) 물어보다 / 확인받다", "example": "Let me run it by my manager first.", "example_ko": "먼저 매니저한테 확인받을게요.", "register": "business" },
    { "id": "ph4", "cat": "phrasal", "term": "wrap up", "ko": "마무리하다", "example": "Let's wrap up and continue tomorrow.", "example_ko": "오늘은 마무리하고 내일 이어가죠.", "register": "neutral" },
    { "id": "ph5", "cat": "phrasal", "term": "follow up", "ko": "후속 조치하다 / 다시 연락하다", "example": "I'll follow up with you by email.", "example_ko": "이메일로 다시 연락드릴게요.", "register": "business" },
    { "id": "ph6", "cat": "phrasal", "term": "check in", "ko": "상황을 확인하다 / 안부 묻다", "example": "Just checking in to see how it's going.", "example_ko": "어떻게 돼가나 해서 확인차 연락했어요.", "register": "business" },
    { "id": "ph7", "cat": "phrasal", "term": "look into", "ko": "조사하다 / 알아보다", "example": "I'll look into it and let you know.", "example_ko": "알아보고 알려드릴게요.", "register": "business" },
    { "id": "ph8", "cat": "phrasal", "term": "come up with", "ko": "(아이디어를) 생각해 내다", "example": "We need to come up with a plan B.", "example_ko": "플랜 B를 생각해 내야 해요.", "register": "neutral" },
    { "id": "ph9", "cat": "phrasal", "term": "get back to", "ko": "~에게 다시 연락하다", "example": "Can I get back to you on that?", "example_ko": "그건 좀 있다 다시 알려드려도 될까요?", "register": "business" },
    { "id": "ph10", "cat": "phrasal", "term": "deal with", "ko": "처리하다 / 감당하다", "example": "I'll deal with the client; you take the report.", "example_ko": "고객은 내가 맡을게, 넌 보고서 해.", "register": "neutral" },

    { "id": "bu1", "cat": "business", "term": "touch base", "ko": "잠깐 상의하다 / 근황 공유하다", "example": "Let's touch base early next week.", "example_ko": "다음 주 초에 잠깐 얘기 나눠요.", "register": "business" },
    { "id": "bu2", "cat": "business", "term": "circle back", "ko": "(나중에) 다시 논의하다", "example": "Let's circle back on this after lunch.", "example_ko": "이건 점심 후에 다시 얘기하죠.", "register": "business" },
    { "id": "bu3", "cat": "business", "term": "on the same page", "ko": "같은 생각이다 / 합의된 상태다", "example": "Let's make sure we're on the same page.", "example_ko": "우리 생각이 같은지 확인하고 가죠.", "register": "business" },
    { "id": "bu4", "cat": "business", "term": "loop in", "ko": "~를 (논의에) 포함시키다 / 공유하다", "example": "Let's loop in marketing on this.", "example_ko": "이건 마케팅팀도 포함시키죠.", "register": "business" },
    { "id": "bu5", "cat": "business", "term": "bandwidth", "ko": "(처리할) 여유·여력", "example": "I don't have the bandwidth for this right now.", "example_ko": "지금 이걸 처리할 여력이 없어요.", "register": "business" },
    { "id": "bu6", "cat": "business", "term": "ballpark", "ko": "대략적인 추정치", "example": "Can you give me a ballpark figure?", "example_ko": "대략적인 수치 좀 줄 수 있어요?", "register": "business" },
    { "id": "bu7", "cat": "business", "term": "move the needle", "ko": "실질적인 변화를 만들다", "example": "This feature won't really move the needle.", "example_ko": "이 기능은 실질적인 변화를 못 만들 거예요.", "register": "business" },
    { "id": "bu8", "cat": "business", "term": "low-hanging fruit", "ko": "쉽게 얻을 수 있는 성과", "example": "Let's start with the low-hanging fruit.", "example_ko": "쉬운 것부터 먼저 처리하죠.", "register": "business" },
    { "id": "bu9", "cat": "business", "term": "take it offline", "ko": "(회의 밖에서) 따로 논의하다", "example": "Good point — let's take it offline.", "example_ko": "좋은 의견이에요 — 그건 따로 얘기하죠.", "register": "business" },
    { "id": "bu10", "cat": "business", "term": "give me a heads-up", "ko": "미리 알려 주다", "example": "Give me a heads-up before you send it.", "example_ko": "보내기 전에 미리 알려 줘요.", "register": "business" },
    { "id": "bu11", "cat": "business", "term": "EOD (end of day)", "ko": "퇴근 전까지 / 그날 안에", "example": "I'll have it to you by EOD.", "example_ko": "오늘 퇴근 전까지 보내드릴게요.", "register": "business" },
    { "id": "bu12", "cat": "business", "term": "reach out", "ko": "연락을 취하다 / 먼저 다가가다", "example": "Feel free to reach out if you have questions.", "example_ko": "질문 있으면 편하게 연락 주세요.", "register": "business" },

    { "id": "me1", "cat": "meetings", "term": "Let's get started.", "ko": "시작하죠", "example": "Everyone's here — let's get started.", "example_ko": "다 오셨네요 — 시작하죠.", "register": "business" },
    { "id": "me2", "cat": "meetings", "term": "Can everyone hear me?", "ko": "다들 잘 들리세요? (화상회의)", "example": "Can everyone hear me okay?", "example_ko": "다들 잘 들리세요?", "register": "business" },
    { "id": "me3", "cat": "meetings", "term": "You're on mute.", "ko": "음소거 되어 있어요", "example": "Sorry, you're on mute.", "example_ko": "저기, 음소거 되어 있어요.", "register": "business" },
    { "id": "me4", "cat": "meetings", "term": "Let me share my screen.", "ko": "화면 공유할게요", "example": "Let me share my screen real quick.", "example_ko": "잠깐 화면 공유할게요.", "register": "business" },
    { "id": "me5", "cat": "meetings", "term": "To recap,", "ko": "정리하자면,", "example": "To recap, we ship Friday and review Monday.", "example_ko": "정리하자면, 금요일 출시하고 월요일 검토예요.", "register": "business" },
    { "id": "me6", "cat": "meetings", "term": "Let's table that.", "ko": "그건 일단 보류하죠", "example": "Let's table that for now and move on.", "example_ko": "그건 일단 보류하고 넘어가죠.", "register": "business" },
    { "id": "me7", "cat": "meetings", "term": "Any thoughts?", "ko": "의견 있으세요?", "example": "That's my proposal — any thoughts?", "example_ko": "제 제안은 이거예요 — 의견 있으세요?", "register": "business" },
    { "id": "me8", "cat": "meetings", "term": "Let's take it from the top.", "ko": "처음부터 다시 보죠", "example": "I'm a bit lost — let's take it from the top.", "example_ko": "조금 헷갈리네요 — 처음부터 다시 보죠.", "register": "business" },
    { "id": "me9", "cat": "meetings", "term": "I'll send the action items.", "ko": "할 일 목록 보내드릴게요", "example": "I'll send the action items after the call.", "example_ko": "통화 끝나고 할 일 목록 보내드릴게요.", "register": "business" },
    { "id": "me10", "cat": "meetings", "term": "Let's keep it brief.", "ko": "간단하게 하죠", "example": "We're short on time, so let's keep it brief.", "example_ko": "시간이 없으니 간단하게 하죠.", "register": "business" },

    { "id": "ca1", "cat": "casual", "term": "Hang on.", "ko": "잠깐만 / 기다려 봐", "example": "Hang on, let me grab my keys.", "example_ko": "잠깐만, 열쇠 좀 챙길게.", "register": "casual" },
    { "id": "ca2", "cat": "casual", "term": "I'm down.", "ko": "나 좋아 / 나 할래 (제안 수락)", "example": "Pizza tonight? — I'm down.", "example_ko": "오늘 피자 어때? — 나 좋아.", "register": "casual" },
    { "id": "ca3", "cat": "casual", "term": "It's on me.", "ko": "내가 살게", "example": "Dinner's on me tonight.", "example_ko": "오늘 저녁은 내가 살게.", "register": "casual" },
    { "id": "ca4", "cat": "casual", "term": "Give me a sec.", "ko": "잠깐만 시간 줘", "example": "Give me a sec, I'm almost ready.", "example_ko": "잠깐만, 거의 다 됐어.", "register": "casual" },
    { "id": "ca5", "cat": "casual", "term": "I'm beat.", "ko": "완전 지쳤어 / 녹초야", "example": "I'm beat — I'm calling it a night.", "example_ko": "완전 지쳤어 — 오늘은 이만 잘래.", "register": "casual" },
    { "id": "ca6", "cat": "casual", "term": "That's so random.", "ko": "완전 뜬금없다", "example": "He texted me out of nowhere — so random.", "example_ko": "걔가 갑자기 문자했어 — 완전 뜬금없어.", "register": "casual" },
    { "id": "ca7", "cat": "casual", "term": "I'll hit you up.", "ko": "내가 연락할게", "example": "I'll hit you up when I'm free.", "example_ko": "시간 되면 내가 연락할게.", "register": "casual" },
    { "id": "ca8", "cat": "casual", "term": "My treat.", "ko": "내가 쏠게", "example": "Let's get coffee — my treat.", "example_ko": "커피 마시자 — 내가 쏠게.", "register": "casual" },
    { "id": "ca9", "cat": "casual", "term": "Call it a day.", "ko": "오늘은 이만 끝내자", "example": "We've done enough — let's call it a day.", "example_ko": "충분히 했어 — 오늘은 이만 끝내자.", "register": "neutral" },
    { "id": "ca10", "cat": "casual", "term": "No biggie.", "ko": "별거 아냐", "example": "Sorry for the mix-up. — No biggie.", "example_ko": "헷갈리게 해서 미안. — 별거 아냐.", "register": "casual" },

    { "id": "em1", "cat": "email", "term": "Just following up.", "ko": "다시 확인차 연락드려요 (후속)", "example": "Just following up on my last email.", "example_ko": "지난 이메일 관련해서 다시 확인차 연락드려요.", "register": "business" },
    { "id": "em2", "cat": "email", "term": "Just a heads-up.", "ko": "미리 알려드려요", "example": "Just a heads-up — the deadline moved to Friday.", "example_ko": "미리 알려드려요 — 마감이 금요일로 옮겨졌어요.", "register": "business" },
    { "id": "em3", "cat": "email", "term": "Thanks in advance.", "ko": "미리 감사드려요", "example": "Could you review this? Thanks in advance.", "example_ko": "이것 좀 검토해 주실래요? 미리 감사드려요.", "register": "business" },
    { "id": "em4", "cat": "email", "term": "Let me know your thoughts.", "ko": "의견 알려주세요", "example": "Here's the draft — let me know your thoughts.", "example_ko": "초안이에요 — 의견 알려주세요.", "register": "business" },
    { "id": "em5", "cat": "email", "term": "Looping in", "ko": "~를 (참조로) 추가합니다", "example": "Looping in Sarah, who owns this.", "example_ko": "이 업무 담당인 Sarah를 참조에 추가합니다.", "register": "business" },
    { "id": "em6", "cat": "email", "term": "Per my last email,", "ko": "지난 이메일에서 말씀드렸듯이 (정중한 재차 강조)", "example": "Per my last email, the file is attached.", "example_ko": "지난 이메일에서 말씀드렸듯이, 파일 첨부했어요.", "register": "business" },
    { "id": "em7", "cat": "email", "term": "Flagging this for you.", "ko": "이 건 한번 봐주십사 알려드려요", "example": "Flagging this for you — it might need a quick look.", "example_ko": "이 건 한번 봐주십사 알려드려요 — 잠깐 확인이 필요할 듯해요.", "register": "business" },
    { "id": "em8", "cat": "email", "term": "Sounds like a plan.", "ko": "그럼 그렇게 하죠 (계획 확정)", "example": "Let's sync Monday. — Sounds like a plan.", "example_ko": "월요일에 맞춰보죠. — 그럼 그렇게 하죠.", "register": "business" },
    { "id": "em9", "cat": "email", "term": "Will do.", "ko": "그렇게 할게요 (간단 수락)", "example": "Can you cc me? — Will do.", "example_ko": "저 참조 넣어줄래요? — 그렇게 할게요.", "register": "business" },
    { "id": "em10", "cat": "email", "term": "Quick question —", "ko": "간단한 질문인데요", "example": "Quick question — is this still the latest version?", "example_ko": "간단한 질문인데, 이게 아직 최신 버전 맞죠?", "register": "business" },
    { "id": "em11", "cat": "email", "term": "Got it, thanks.", "ko": "확인했어요, 감사합니다", "example": "Got it, thanks — I'll take it from here.", "example_ko": "확인했어요, 감사합니다 — 여기서부터는 제가 맡을게요.", "register": "business" },
    { "id": "em12", "cat": "email", "term": "No worries if not.", "ko": "안 되시면 괜찮아요 (부담 없는 부탁)", "example": "Could you join? No worries if not.", "example_ko": "혹시 참석 가능하세요? 안 되시면 괜찮아요.", "register": "business" },

    { "id": "sv1", "cat": "service", "term": "Can I get...", "ko": "~ 주세요 (주문)", "example": "Can I get a medium latte, please?", "example_ko": "미디엄 라떼 하나 주세요.", "register": "neutral" },
    { "id": "sv2", "cat": "service", "term": "For here or to go?", "ko": "여기서 드세요, 가져가세요?", "example": "For here or to go? — To go, please.", "example_ko": "드시고 가세요, 포장이세요? — 포장이요.", "register": "neutral" },
    { "id": "sv3", "cat": "service", "term": "I'll have the...", "ko": "저는 ~로 할게요 (메뉴 선택)", "example": "I'll have the cheeseburger, no onions.", "example_ko": "저는 치즈버거로 할게요, 양파는 빼고요.", "register": "neutral" },
    { "id": "sv4", "cat": "service", "term": "Can we get the check?", "ko": "계산서 주시겠어요?", "example": "Whenever you get a chance, can we get the check?", "example_ko": "시간 되실 때, 계산서 좀 주시겠어요?", "register": "neutral" },
    { "id": "sv5", "cat": "service", "term": "Keep the change.", "ko": "잔돈은 됐어요 (팁)", "example": "Here's twenty — keep the change.", "example_ko": "여기 20달러요 — 잔돈은 됐어요.", "register": "casual" },
    { "id": "sv6", "cat": "service", "term": "Do you take cards?", "ko": "카드 되나요?", "example": "Do you take cards, or is it cash only?", "example_ko": "카드 되나요, 아니면 현금만 받으세요?", "register": "neutral" },
    { "id": "sv7", "cat": "service", "term": "Could I get a refill?", "ko": "리필 좀 해주시겠어요?", "example": "Excuse me, could I get a refill?", "example_ko": "저기요, 리필 좀 해주시겠어요?", "register": "neutral" },
    { "id": "sv8", "cat": "service", "term": "Is this seat taken?", "ko": "여기 자리 있나요?", "example": "Hi, is this seat taken?", "example_ko": "안녕하세요, 여기 자리 있나요?", "register": "neutral" },
    { "id": "sv9", "cat": "service", "term": "I'm just browsing.", "ko": "그냥 둘러보는 거예요 (매장)", "example": "Need help? — I'm just browsing, thanks.", "example_ko": "도와드릴까요? — 그냥 둘러보는 거예요, 감사합니다.", "register": "neutral" },
    { "id": "sv10", "cat": "service", "term": "Can you break a twenty?", "ko": "20달러 잔돈으로 바꿔주실 수 있어요?", "example": "Sorry, can you break a twenty?", "example_ko": "죄송한데, 20달러 잔돈으로 바꿔주실 수 있어요?", "register": "casual" },
    { "id": "sv11", "cat": "service", "term": "That'll be all.", "ko": "그게 다예요 (주문 마무리)", "example": "Anything else? — That'll be all, thanks.", "example_ko": "더 필요하세요? — 그게 다예요, 감사합니다.", "register": "neutral" },
    { "id": "sv12", "cat": "service", "term": "Could you make it to go?", "ko": "포장으로 해주시겠어요?", "example": "Actually, could you make it to go?", "example_ko": "아, 그거 포장으로 해주시겠어요?", "register": "neutral" },

    { "id": "pl1", "cat": "plans", "term": "Works for me.", "ko": "난 괜찮아 / 좋아 (일정)", "example": "Friday at noon? — Works for me.", "example_ko": "금요일 정오? — 난 괜찮아.", "register": "neutral" },
    { "id": "pl2", "cat": "plans", "term": "Count me in.", "ko": "나도 낄게 / 참여할게", "example": "We're doing dinner Saturday. — Count me in.", "example_ko": "토요일에 저녁 먹기로 했어. — 나도 낄게.", "register": "casual" },
    { "id": "pl3", "cat": "plans", "term": "I'll take a rain check.", "ko": "다음 기회로 미룰게 (정중한 거절)", "example": "Drinks tonight? — I'll take a rain check.", "example_ko": "오늘 한잔할래? — 다음 기회로 미룰게.", "register": "casual" },
    { "id": "pl4", "cat": "plans", "term": "Let's pencil it in.", "ko": "일단 잠정적으로 잡아두자", "example": "Let's pencil in the 5th and confirm later.", "example_ko": "일단 5일로 잠정적으로 잡고 나중에 확정하자.", "register": "business" },
    { "id": "pl5", "cat": "plans", "term": "I'm tied up.", "ko": "바빠서 손이 안 나 / 일정이 꽉 찼어", "example": "I'm tied up until 3, can we do later?", "example_ko": "3시까지 바빠서, 좀 이따 해도 될까?", "register": "neutral" },
    { "id": "pl6", "cat": "plans", "term": "Can we push it back?", "ko": "(일정을) 좀 미룰 수 있을까?", "example": "Can we push it back an hour?", "example_ko": "한 시간만 뒤로 미룰 수 있을까요?", "register": "business" },
    { "id": "pl7", "cat": "plans", "term": "Let's touch base later.", "ko": "나중에 다시 얘기하자", "example": "I'm busy now — let's touch base later.", "example_ko": "지금 바빠서 — 나중에 다시 얘기하자.", "register": "business" },
    { "id": "pl8", "cat": "plans", "term": "I'm free after 5.", "ko": "5시 이후면 시간 돼", "example": "I'm free after 5 if that works.", "example_ko": "괜찮으면 5시 이후엔 시간 돼.", "register": "neutral" },
    { "id": "pl9", "cat": "plans", "term": "Something came up.", "ko": "갑자기 일이 생겼어", "example": "I have to cancel — something came up.", "example_ko": "취소해야 할 것 같아 — 갑자기 일이 생겼어.", "register": "neutral" },
    { "id": "pl10", "cat": "plans", "term": "Let's lock it in.", "ko": "그걸로 확정하자", "example": "Tuesday at 10 — let's lock it in.", "example_ko": "화요일 10시 — 그걸로 확정하자.", "register": "business" },
    { "id": "pl11", "cat": "plans", "term": "I'll swing by.", "ko": "잠깐 들를게", "example": "I'll swing by around six.", "example_ko": "6시쯤 잠깐 들를게.", "register": "casual" },
    { "id": "pl12", "cat": "plans", "term": "Are we still on for...?", "ko": "~ 그대로 하는 거지? (약속 확인)", "example": "Are we still on for lunch tomorrow?", "example_ko": "내일 점심 그대로 하는 거지?", "register": "neutral" },

    { "id": "fl1", "cat": "connectors", "term": "By the way,", "ko": "그건 그렇고 / 참 (화제 전환)", "example": "By the way, did you get my message?", "example_ko": "그건 그렇고, 내 메시지 받았어?", "register": "neutral" },
    { "id": "fl2", "cat": "connectors", "term": "Anyway,", "ko": "어쨌든 / 아무튼 (본론·마무리)", "example": "Anyway, let's get back to the point.", "example_ko": "아무튼, 다시 본론으로 돌아가자.", "register": "neutral" },
    { "id": "fl3", "cat": "connectors", "term": "To be honest,", "ko": "솔직히 말하면", "example": "To be honest, I'm not a fan of it.", "example_ko": "솔직히 말하면, 난 별로야.", "register": "neutral" },
    { "id": "fl4", "cat": "connectors", "term": "I mean,", "ko": "내 말은 / 그러니까 (부연·정정)", "example": "I mean, it's fine, just not my favorite.", "example_ko": "그러니까, 괜찮긴 한데 제일 좋아하는 건 아냐.", "register": "casual" },
    { "id": "fl5", "cat": "connectors", "term": "That said,", "ko": "그렇긴 한데 / 그래도 (반전)", "example": "It's pricey. That said, the quality is great.", "example_ko": "비싸. 그렇긴 한데, 품질은 훌륭해.", "register": "neutral" },
    { "id": "fl6", "cat": "connectors", "term": "Long story short,", "ko": "간단히 말하면 / 요약하자면", "example": "Long story short, we missed the flight.", "example_ko": "간단히 말하면, 우리 비행기 놓쳤어.", "register": "casual" },
    { "id": "fl7", "cat": "connectors", "term": "Speaking of which,", "ko": "말 나온 김에", "example": "Speaking of which, are you free this weekend?", "example_ko": "말 나온 김에, 이번 주말에 시간 돼?", "register": "neutral" },
    { "id": "fl8", "cat": "connectors", "term": "Come to think of it,", "ko": "생각해 보니", "example": "Come to think of it, I've been there before.", "example_ko": "생각해 보니, 나 거기 가본 적 있어.", "register": "neutral" },
    { "id": "fl9", "cat": "connectors", "term": "On second thought,", "ko": "다시 생각해 보니 (마음 바꿈)", "example": "On second thought, let's just stay in.", "example_ko": "다시 생각해 보니, 그냥 집에 있자.", "register": "neutral" },
    { "id": "fl10", "cat": "connectors", "term": "You know what?", "ko": "있잖아 / 그거 알아? (말 꺼내기)", "example": "You know what? Let's just do it.", "example_ko": "있잖아, 그냥 하자.", "register": "casual" },
    { "id": "fl11", "cat": "connectors", "term": "Like I said,", "ko": "아까 말했듯이", "example": "Like I said, it's totally up to you.", "example_ko": "아까 말했듯이, 전적으로 네가 정하면 돼.", "register": "neutral" },
    { "id": "fl12", "cat": "connectors", "term": "At the end of the day,", "ko": "결국엔 / 따지고 보면", "example": "At the end of the day, it's your call.", "example_ko": "결국엔, 네가 결정할 일이야.", "register": "neutral" }
  ]
}
