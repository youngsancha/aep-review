# ─────────── Supabase (인제스트 / 마이그레이션 sink) ───────────
# supabase/README.md 3단계에서 복사. service_role 은 RLS 우회 → 절대 비공개·커밋 금지.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...

# 프론트(ui/config.js)에는 anon public 키를 넣는다 (여기 아님).

# ─────────── 인제스트 옵션 ───────────
# faster-whisper 디바이스 — auto / cuda / cpu
AEP_WHISPER_DEVICE=auto
# vocab 추출은 claude CLI(Claude Max) 사용 — API key 불필요.

# ─────────── 레거시(api/ 로컬 서버) — 클라우드 배포엔 불필요 ───────────
# PORT=8767
# AEP_RELOAD=1
