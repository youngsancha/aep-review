# ─────────── Supabase (인제스트 sink) ───────────
# supabase/README.md 3단계에서 복사. secret 키는 RLS 우회 → 절대 비공개·커밋 금지.
# 새 키 스타일(sb_secret_… / sb_publishable_…) 사용 — 레거시 JWT(eyJ…) anon/service_role 은 2026말 폐기 예정.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# 프론트(ui/config.js)에는 publishable 키(sb_publishable_…)를 넣는다 (여기 아님).

# ─────────── 인제스트 옵션 ───────────
# faster-whisper 디바이스 — auto / cuda / cpu
AEP_WHISPER_DEVICE=auto
# vocab 추출은 claude CLI(Claude Max) 사용 — API key 불필요.
