# ─────────── Supabase (인제스트 sink) ───────────
# supabase/README.md 3단계에서 복사. secret 키는 RLS 우회 → 절대 비공개·커밋 금지.
# 새 키 스타일(sb_secret_… / sb_publishable_…) 사용 — 레거시 JWT(eyJ…) anon/service_role 은 2026말 폐기 예정.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# 프론트(ui/config.js)에는 publishable 키(sb_publishable_…)를 넣는다 (여기 아님).

# ─────────── 인제스트 옵션 ───────────
# faster-whisper 디바이스 — auto / cuda / cpu
AEP_WHISPER_DEVICE=auto
# vocab 추출은 claude CLI(Claude Max) 사용 — API key 불필요.

# ── LLM 백엔드 선택 (선택) ────────────────────────────────────
# vocab 추출을 무엇으로 돌릴지. 미설정 = claude-cli (기존 동작, Max 구독이라 과금 0).
#   claude-cli : `claude -p` subprocess. 로그인된 Claude Code CLI 필요.
#   gemini     : HTTP. CLI 없는 서버/CI/cron 에서 vocab 단계를 살린다.
#   auto       : claude CLI 있으면 그것, 없으면 gemini 폴백.
AEP_LLM_BACKEND=

# Gemini 자격증명 (위가 gemini/auto 일 때만 필요)
# 권장) Vertex AI + 서비스 계정 — 키가 만료되지 않아 사람이 갱신할 일이 없다.
#   `vertex-setup --env <이 디렉터리>` 가 아래 3줄을 채워준다.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1
# 비권장) 수동 토큰 — `gcloud auth print-access-token` 은 1시간 만료라 조용히 죽는다. 디버깅용만.
GOOGLE_VERTEX_TOKEN=
# 비권장) AI Studio — 셋업은 쉽지만 자체 선불 잔액을 쓰므로 월 $10 GCP 크레딧이 차감되지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
