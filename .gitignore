__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.env
.env.local
data/
# 단, 앱에 배포되는 정적 데이터 팩(ui/data/)은 추적해야 함 — data/ 규칙이 ui/data 까지
# 잡아 essentials.json 이 커밋 누락 → 프로덕션 404(Essentials 깨짐) 났던 것 방지.
!ui/data/
!ui/data/**
logs/
.DS_Store
.idea/
.vscode/
node_modules/
.vercel
.env*

# Playwright harness fixtures written by scripts/_pwtest.py at run time (13 files, all ui/_*).
# They must never be committed: scripts/release.py runs `git add -A`, so a release taken after a
# test run would otherwise ship test scaffolding to production. release.py's own tracked-asset
# guard already treats `_`-prefixed files as throwaway — this makes git agree with it.
ui/_*
